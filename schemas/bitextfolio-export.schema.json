{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bitextfolio-export.schema.json",
  "title": "BitextFolio Export Payload Schema",
  "description": "Schema for BitextFolio single-project and workspace backup JSON files (schemaVersion 2, with v1 migration support).",
  "type": "object",
  "required": ["schemaVersion", "type", "projects"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "Schema version of the payload. Version 1 and unversioned legacy files are migrated deterministically to 2 on import."
    },
    "exportedAt": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["single_project", "workspace_backup"]
    },
    "settings": {
      "type": "object",
      "properties": {
        "abbreviations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "jaNormOptions": {
          "type": "object",
          "properties": {
            "normalizeWidth": { "type": "boolean" },
            "normalizeLongVowel": { "type": "boolean" },
            "normalizeOkurigana": { "type": "boolean" },
            "fuzzyTypoCheck": { "type": "boolean" },
            "fuzzyMinLength": { "type": "integer", "minimum": 3, "maximum": 10 }
          }
        }
      }
    },
    "glossary": {
      "type": "array",
      "items": { "$ref": "#/$defs/GlossaryEntry" }
    },
    "tmRecords": {
      "type": "array",
      "items": { "type": "object" }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/DocumentProject" }
    }
  },
  "$defs": {
    "MarkerRange": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "SentenceItem": {
      "type": "object",
      "required": ["id", "rawText"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rawText": { "type": "string" },
        "plainText": { "type": "string" },
        "markers": {
          "type": "array",
          "items": { "$ref": "#/$defs/MarkerRange" }
        }
      }
    },
    "ClauseSpan": {
      "type": "object",
      "required": ["sentenceId", "start", "end"],
      "properties": {
        "sentenceId": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" }
      }
    },
    "ClausePair": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enSpan": { "oneOf": [{ "$ref": "#/$defs/ClauseSpan" }, { "type": "null" }] },
        "jaSpan": { "oneOf": [{ "$ref": "#/$defs/ClauseSpan" }, { "type": "null" }] },
        "checked": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "AlignmentGroup": {
      "type": "object",
      "required": ["id", "enIds", "jaIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "jaIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "status": {
          "type": "string",
          "enum": ["unread", "read", "verified", "needs_review", "source_changed"]
        },
        "memo": { "type": "string" },
        "previousMemoNote": { "type": "string" },
        "tempNoOmission": { "type": "boolean" },
        "tempNoOmissionAt": { "type": "string" },
        "confirmedAlignment": { "type": "boolean" },
        "clausePairs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ClausePair" }
        }
      }
    },
    "AlignmentBlock": {
      "type": "object",
      "required": ["id", "enSentences", "jaSentences", "groups"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "enRaw": { "type": "string" },
        "jaRaw": { "type": "string" },
        "enLang": { "type": ["string", "null"] },
        "jaLang": { "type": ["string", "null"] },
        "enConfidence": { "type": "number" },
        "jaConfidence": { "type": "number" },
        "splitInsideList": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "enHash": { "type": "string" },
        "jaHash": { "type": "string" },
        "enSentences": { "type": "array", "items": { "$ref": "#/$defs/SentenceItem" } },
        "jaSentences": { "type": "array", "items": { "$ref": "#/$defs/SentenceItem" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/AlignmentGroup" } }
      }
    },
    "DocumentProject": {
      "type": "object",
      "required": ["id", "blocks"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "rawSourceText": { "type": "string" },
        "abbreviations": { "type": "array", "items": { "type": "string" } },
        "splitInsideList": { "type": "boolean" },
        "lastFocusedGroupId": { "type": ["string", "null"] },
        "dismissedHints": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/AlignmentBlock" }
        }
      }
    },
    "GlossaryEntry": {
      "type": "object",
      "required": ["id", "enHeadword"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enHeadword": { "type": "string", "minLength": 1 },
        "enVariants": { "type": "array", "items": { "type": "string" } },
        "jaAccepted": { "type": "array", "items": { "type": "string" } },
        "jaDeprecated": { "type": "array", "items": { "type": "string" } },
        "caseSensitive": { "type": "boolean" },
        "exactMatch": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
